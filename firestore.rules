rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isEmployer() {
      return isSignedIn() && getUserData().role == 'employer';
    }

    // isAdmin is a site-admin flag set manually in the Firebase console only —
    // never writable by any client, including the owner of the doc it's on.
    function isAdmin() {
      return isSignedIn() && getUserData().isAdmin == true;
    }

    function isOwnerUserUpdateValid() {
      return request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
        && (
          request.resource.data.get('backgroundCheck', {}).get('status', '') != 'clear'
          || resource.data.get('backgroundCheck', {}).get('status', '') == 'clear'
        );
    }

    // Admins may only ever touch backgroundCheck/updatedAt on someone else's doc —
    // the "Mark Clear" demo action — never role, plan, or anything else.
    function isAdminClearingBackgroundCheck() {
      return isAdmin()
        && request.resource.data.backgroundCheck.status == 'clear'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['backgroundCheck', 'updatedAt']);
    }

    // Users
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && request.resource.data.get('isAdmin', false) == false;
      allow update: if (isOwner(uid) && isOwnerUserUpdateValid()) || isAdminClearingBackgroundCheck();
      allow delete: if isOwner(uid);
    }

    // Jobs — public read, employer write
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isEmployer();
      allow update, delete: if isEmployer()
        && resource.data.employerId == request.auth.uid;
    }

    // Companies — public read, owner write
    match /companies/{companyId} {
      allow read: if true;
      allow create: if isEmployer();
      allow update: if isEmployer()
        && resource.data.ownerId == request.auth.uid;
      allow delete: if isEmployer()
        && resource.data.ownerId == request.auth.uid;
    }

    // Applications — worker creates, employer reads their job's apps
    match /applications/{appId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isEmployer()
        );
    }

    // Badges — user manages own, admin verifies
    match /badges/{badgeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // Demo messages — simulated Twilio sends, written by Cloud Functions (Admin SDK,
    // bypasses rules) when DEMO_MODE is on. Tagged isDemo: true so the cleanup script
    // can remove them; any signed-in user may delete (throwaway preview data, no owner).
    match /demoMessages/{id} {
      allow read: if isSignedIn();
      allow create, update: if false;
      allow delete: if isSignedIn();
    }

    // Boosts — created by Cloud Function (service account), read by employer
    match /boosts/{boostId} {
      allow read: if isEmployer()
        && resource.data.employerId == request.auth.uid;
      allow write: if false; // Cloud Function only
    }

    // Checklist responses — worker creates/updates own; employer reads their job's responses
    match /checklistResponses/{responseId} {
      allow read: if isSignedIn() && (
        resource.data.workerId == request.auth.uid
        || (isEmployer() && resource.data.employerId == request.auth.uid)
      );
      allow create: if isSignedIn()
        && request.resource.data.workerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.workerId == request.auth.uid
        || (isEmployer() && resource.data.employerId == request.auth.uid)
      );
    }

    // Ratings — anonymous; submitter writes, no one reads individual docs
    match /ratings/{ratingId} {
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Rapid Fill holds
    match /rapidFillHolds/{holdId} {
      // Workers read their own holds; employers read holds for their jobs
      allow read: if isSignedIn() && (
        resource.data.workerId == request.auth.uid
        || (isEmployer()
            && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.employerId == request.auth.uid)
      );

      // Workers (non-employer) create holds for themselves
      allow create: if isSignedIn()
        && !isEmployer()
        && request.resource.data.workerId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Employers update hold status (confirm/reject) on their own jobs
      allow update: if isEmployer()
        && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.employerId == request.auth.uid
        && request.resource.data.status in ['confirmed', 'rejected'];

      // Cloud Function (service account) handles expiry — no client delete
      allow delete: if false;
    }
  }
}
